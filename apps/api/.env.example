SPRING_PROFILES_ACTIVE=staging

# Prefer JDBC_DATABASE_URL when the provider exposes a JDBC URL.
# DATABASE_URL may also be used with jdbc:postgresql://, postgresql:// or postgres://.
JDBC_DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DATABASE_USERNAME=<database-user>
DATABASE_PASSWORD=<database-password>
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

PORT=8080
JWT_SECRET=<at-least-32-characters-random-secret>
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

APP_CORS_ALLOWED_ORIGINS=https://<vercel-staging-domain>
APP_PUBLIC_URL=https://<vercel-staging-domain>
CHECKIN_QR_TTL_SECONDS=60

# Keep disabled by default outside local development.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_TENANT_NAME=<tenant-name>
BOOTSTRAP_TENANT_SLUG=<tenant-slug>
BOOTSTRAP_OWNER_NAME=<owner-name>
BOOTSTRAP_OWNER_EMAIL=<owner-email>
BOOTSTRAP_OWNER_PASSWORD=<one-time-owner-password>

# Shared operational timezone until Unit timezone is modeled
APP_OPERATIONAL_ZONE=America/Sao_Paulo
